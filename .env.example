# Bot authentication and default prefix list (JSON).
DISCORD_TOKEN=
PREFIX='["e."]'

# Optional X API bearer token. Leave blank to disable Twitter polling.
BEARER_TOKEN=

# Optional HTTP proxy for Steam announcements; blank connects directly.
# Example: STEAM_PROXY_URL=http://192.168.1.9:1080
STEAM_PROXY_URL=

# GitHub commit tracking; blank repository or branch disables polling.
GITHUB_REPO=faberuser/sprk
GITHUB_BRANCH=development
# Also announce PR merges and deployment estimates in subscribed GitHub channels.
# Blank either value to disable deployment announcements.
GITHUB_DEPLOY_BRANCH=main
GITHUB_DEPLOY_WORKFLOW=build-and-deploy.yml
# Optional for public repos; recommended for one-minute deployment checks.
# Fine-grained token permissions: Contents: read and Actions: read.
GITHUB_TOKEN=

# Game dataset defaults.
KR_DEFAULT_VERSION=legacy
KR_LANGUAGE=en

# KRE guide source. Set KRE_GUILD_ID=0 and KRE_CATEGORIES= to disable.
KRE_GUILD_ID=748599474783518941
# Category order: table of contents, beginner, optimization, gear, content,
# heroes A-J, heroes K-Q, heroes R-Z, PvP.
KRE_CATEGORIES=748635757056491649,748600039542358058,748605214856183819,748647024060137605,748605466401046659,748599866967457873,748607570226315346,748612701973905499,748610529194541139
KRE_INVITE=https://discord.gg/cBeMt8jAST
